# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters

# MongoDB Atlas Configuration
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/adaptive_interview_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER/adaptive_interview_db?retryWrites=true&w=majority
MONGO_DB_NAME=adaptive_interview_db

# AI provider selection: auto tries Gemini then Groq; set to groq or gemini to prefer one
AI_PROVIDER=auto

# Google Gemini (optional)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (optional fallback or primary provider)
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional GitHub Personal Access Token (increases API rate limit from 60 to 5000 requests/hr)
GITHUB_TOKEN=

# Upload and Storage Limits
MAX_RESUME_MB=5
UPLOAD_FOLDER=instance/private_resumes

# Security Settings (Set to true in production with HTTPS)
COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
